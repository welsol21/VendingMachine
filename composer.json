{
    "name": "welsol21/vending-machine",
    "description": "PHP vending machine domain model using hexagonal architecture",
    "type": "project",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "VendingMachine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VendingMachine\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
